<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    style="@style/Widget.MaterialComponents.CardView"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="8dp"
    android:clickable="true"
    android:focusable="true"
    app:cardCornerRadius="12dp"
    app:cardElevation="0dp"
    app:strokeColor="@color/cm_borde"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="12dp">

        <TextView
            android:id="@+id/tvAvatar"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:background="@drawable/bg_avatar"
            android:gravity="center"
            android:textColor="@color/cm_primario"
            android:textSize="14sp"
            android:textStyle="bold"
            tools:text="JP" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="8dp">

            <TextView
                android:id="@+id/tvItemPaciente"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/cm_texto_principal"
                android:textSize="15sp"
                android:textStyle="bold"
                tools:text="Juan Pérez (55 años)" />

            <TextView
                android:id="@+id/tvItemHistoria"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/cm_texto_secundario"
                android:textSize="13sp"
                tools:text="Historia: HC-2024-001 | DNI: 99887766D" />
        </LinearLayout>

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
