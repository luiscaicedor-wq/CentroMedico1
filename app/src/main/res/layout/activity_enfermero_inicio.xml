<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/cm_fondo"
    android:orientation="vertical"
    tools:context=".EnfermeroInicioActivity">

    <!-- Header -->
    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbarEnfermero"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/cm_fondo"
        app:menu="@menu/menu_cerrar_sesion"
        app:subtitle="Felipe Romo · Enfermero"
        app:title="Turno Mañana" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.core.widget.NestedScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingHorizontal="16dp"
                android:paddingTop="8dp"
                android:paddingBottom="24dp"
                android:divider="@drawable/espacio_12"
                android:showDividers="middle">

                <!-- Resumen de Métricas -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:baselineAligned="false"
                    android:divider="@drawable/espacio_12"
                    android:orientation="horizontal"
                    android:showDividers="middle">

                    <com.google.android.material.card.MaterialCardView
                        style="@style/Widget.MaterialComponents.CardView"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        app:cardCornerRadius="14dp"
                        app:cardElevation="0dp"
                        app:strokeColor="@color/cm_borde"
                        app:strokeWidth="1dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:padding="14dp">

                            <TextView
                                android:id="@+id/tvPacientesAsignados"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:textColor="@color/cm_texto_principal"
                                android:textSize="22sp"
                                android:textStyle="bold"
                                tools:text="1" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Pacientes asignados"
                                android:textColor="@color/cm_texto_secundario"
                                android:textSize="12sp" />
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>

                    <com.google.android.material.card.MaterialCardView
                        style="@style/Widget.MaterialComponents.CardView"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        app:cardCornerRadius="14dp"
                        app:cardElevation="0dp"
                        app:strokeColor="@color/cm_borde"
                        app:strokeWidth="1dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:padding="14dp">

                            <TextView
                                android:id="@+id/tvRegistrosHechos"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:textColor="@color/cm_texto_principal"
                                android:textSize="22sp"
                                android:textStyle="bold"
                                tools:text="0" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Registros hechos"
                                android:textColor="@color/cm_texto_secundario"
                                android:textSize="12sp" />
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>
                </LinearLayout>

                <!-- PACIENTES DEL TURNO -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="PACIENTES DEL TURNO"
                    android:textAllCaps="true"
                    android:textColor="@color/cm_texto_secundario"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <!-- Card de Paciente Asignado -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardPacienteTurno"
                    style="@style/Widget.MaterialComponents.CardView"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cardCornerRadius="14dp"
                    app:cardElevation="0dp"
                    app:strokeColor="@color/cm_borde"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <TextView
                                android:id="@+id/tvAvatarTurno"
                                android:layout_width="44dp"
                                android:layout_height="44dp"
                                android:background="@drawable/bg_avatar"
                                android:gravity="center"
                                android:textColor="@color/cm_primario"
                                android:textSize="15sp"
                                android:textStyle="bold"
                                tools:text="JP" />

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="12dp"
                                android:layout_weight="1"
                                android:orientation="vertical">

                                <TextView
                                    android:id="@+id/tvNombrePacienteTurno"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:textColor="@color/cm_texto_principal"
                                    android:textSize="16sp"
                                    android:textStyle="bold"
                                    tools:text="Juan Pérez" />

                                <TextView
                                    android:id="@+id/tvHistoriaPacienteTurno"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:textColor="@color/cm_texto_secundario"
                                    android:textSize="13sp"
                                    tools:text="HC-2024-001 · 55 años" />
                            </LinearLayout>

                            <com.google.android.material.chip.Chip
                                android:id="@+id/chipEstadoTurno"
                                style="@style/Widget.MaterialComponents.Chip.Choice"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:clickable="false"
                                android:text="Pendiente"
                                app:chipBackgroundColor="@color/cm_primario_contenedor" />
                        </LinearLayout>

                        <TextView
                            android:id="@+id/tvDetalleConsultaTurno"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp"
                            android:textColor="@color/cm_texto_secundario"
                            android:textSize="13sp"
                            tools:text="Consulta 2025-09-10 · Dra. Camila Cifuentes · Dolor en el pecho" />

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="1dp"
                            android:layout_marginVertical="12dp"
                            android:background="@color/cm_borde" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:baselineAligned="false"
                            android:divider="@drawable/espacio_12"
                            android:orientation="horizontal"
                            android:showDividers="middle">

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btnTomarSignos"
                                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                                android:layout_width="0dp"
                                android:layout_height="48dp"
                                android:layout_weight="1"
                                android:text="Signos"
                                app:icon="@drawable/ic_pulse" />

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btnMedicar"
                                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                                android:layout_width="0dp"
                                android:layout_height="48dp"
                                android:layout_weight="1"
                                android:text="Medicar"
                                app:icon="@drawable/ic_pill" />
                        </LinearLayout>

                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

            </LinearLayout>
        </androidx.core.widget.NestedScrollView>
    </FrameLayout>

    <!-- Bottom Navigation Bar -->
    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottomNavEnfermero"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:labelVisibilityMode="labeled"
        app:menu="@menu/menu_nav_enfermero" />

</LinearLayout>